new file mode 100644
index 0000000..9731a91
--- /dev/null
+++ b/dist/bundle/chunks/rg-json-context.js
@@ -0,0 +1,48 @@
+// Local compatibility patch for Eve's context-bearing JSON ripgrep output.
+export function* rgJsonContext(content, regex, options, path) {
+  const lines = content.match(/[^\n]*\n|[^\n]+$/g) ?? [];
+  const matches = new Map();
+  let first = lines.length;
+  let last = -1;
+  for (let index = 0; index < lines.length; index++) {
+    const line = lines[index].replace(/\n$/, "");
+    const submatches = [];
+    regex.lastIndex = 0;
+    for (let match = regex.exec(line); match !== null; match = regex.exec(line)) {
+      const submatch = {
+        match: { text: match[0] },
+        start: Buffer.byteLength(line.slice(0, match.index)),
+        end: Buffer.byteLength(line.slice(0, match.index + match[0].length)),
+      };
+      if (options.replace !== null) submatch.replacement = { text: options.replace };
+      submatches.push(submatch);
+      if (match[0].length === 0) regex.lastIndex++;
+    }
+    if (options.invertMatch ? submatches.length === 0 : submatches.length > 0) {
+      matches.set(index, options.invertMatch ? [] : submatches);
+      first = Math.min(first, Math.max(0, index - options.beforeContext));
+      last = Math.min(lines.length - 1, index + options.afterContext);
+      if (options.maxCount > 0 && matches.size >= options.maxCount) break;
+    }
+  }
+  const indices = [...matches.keys()];
+  let nextMatch = 0;
+  let offset = 0;
+  for (let index = 0; index <= last; index++) {
+    while (nextMatch < indices.length && indices[nextMatch] + options.afterContext < index) nextMatch++;
+    if (index >= first && nextMatch < indices.length && index >= indices[nextMatch] - options.beforeContext) {
+      const isMatch = matches.has(index);
+      yield JSON.stringify({
+        type: isMatch ? "match" : "context",
+        data: {
+          path: { text: path },
+          lines: { text: lines[index] },
+          line_number: index + 1,
+          absolute_offset: offset,
+          submatches: isMatch ? matches.get(index) : [],
+        },
+      });
+    }
+    offset += Buffer.byteLength(lines[index]);
+  }
+}
